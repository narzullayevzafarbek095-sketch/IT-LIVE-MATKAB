# Server Port (Render, Railway, Heroku automatically set this)
PORT=8000

# Database Connection String
# Use SQLite for default zero-config deployment:
DATABASE_URL=sqlite:///./itlive.db
# Or PostgreSQL for production cloud database:
# DATABASE_URL=postgresql://username:password@hostname:5432/itlive_db

# Security & JWT Token Secret
SECRET_KEY=it-live-super-secret-cyber-key-2026-production

# CORS Allowed Origins (* or comma-separated list of domains)
CORS_ORIGINS=*

# Frontend API URL (Only needed if frontend is hosted separately on Vercel/Netlify)
# VITE_API_BASE_URL=https://your-backend-domain.onrender.com/api

